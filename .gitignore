# REGENERABLE
# Outputs that a command rebuilds.
__pycache__/
node_modules/
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts
# Impeccable: generated review captures and decision sketches
.impeccable/review/
.impeccable/mocks/
# GeorgOS: per-project structural code graph. Rebuild: graphify extract <unit> --code-only
graphify-out/

